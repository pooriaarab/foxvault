{
  "manifest_version": 3,
  "name": "foxvault — keep secrets out of AI prompts",
  "version": "0.1.2",
  "description": "Keep API keys and card numbers encrypted and out of the AI model's context.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxvault@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "publicSuffix", "webRequest", "webRequestBlocking", "scripting", "webNavigation"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "default_title": "foxvault",
    "default_popup": "popup.html"
  }
}
