{
  "manifest_version": 3,
  "name": "foxvault demo",
  "version": "0.1.0",
  "description": "Keep API keys and card numbers encrypted and out of the AI model's context.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxvault@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "publicSuffix", "webRequest", "webRequestBlocking"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://*.localhost/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "foxvault demo",
    "default_popup": "popup.html"
  }
}
